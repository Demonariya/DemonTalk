#:import dp kivy.metrics.dp
#:import rgba kivy.utils rgba

<ChannelsScreen>:
    name: 'channels'
    canvas.before:
        Color:
            rgba: rgba('#0a0a0f')
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: dp(16)
        spacing: dp(12)

        # Header
        BoxLayout:
            size_hint_y: None
            height: dp(48)

            Label:
                text: 'CHANNELS'
                font_size: '22sp'
                color: rgba('#e8e8f0')
                bold: True
                text_size: self.size
                halign: 'left'
                valign: 'middle'

            Button:
                size_hint_x: None
                width: dp(48)
                text: '+'
                font_size: '24sp'
                color: rgba('#b44aff')
                background_color: rgba('#1a1a2e')
                background_normal: ''
                on_release: root.show_create_dialog()
                canvas.before:
                    Color:
                        rgba: rgba('#1a1a2e')
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(12)]

        # Channel list
        ScrollView:
            bar_color: rgba('#b44aff40')
            bar_width: dp(3)

            BoxLayout:
                id: channel_list
                orientation: 'vertical'
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height
                padding: [0, 0, 0, dp(80)]

        # Empty state
        Label:
            id: empty_label
            text: 'No channels yet.\nCreate one to get started.'
            font_size: '15sp'
            color: rgba('#555577')
            halign: 'center'
            valign: 'middle'
            text_size: self.size
